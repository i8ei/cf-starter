{
  "name": "cf-starter",
  "compatibility_date": "2025-12-30",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/index.ts",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cf-starter-db",
      // Template placeholder: set the real id in the generated app / deployed environment.
      "database_id": "TODO",
      "migrations_dir": "./migrations"
    }
  ],
  // KV — uncomment if needed. Remove KV from src/types.ts Env if not used.
  // "kv_namespaces": [
  //   {
  //     "binding": "KV",
  //     "id": "TODO"
  //   }
  // ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "cf-starter-bucket"
    }
  ],
  // DurableObjects — uncomment if needed (e.g. rate limiter).
  // Also add RATE_LIMITER to src/types.ts Env and uncomment migrations below.
  // "durable_objects": {
  //   "bindings": [
  //     {
  //       "name": "RATE_LIMITER",
  //       "class_name": "RateLimiter"
  //     }
  //   ]
  // },
  // Queues — uncomment if needed. Also add JOBS to src/types.ts Env.
  // "queues": {
  //   "producers": [
  //     {
  //       "binding": "JOBS",
  //       "queue": "cf-starter-jobs"
  //     }
  //   ],
  //   "consumers": [
  //     {
  //       "queue": "cf-starter-jobs",
  //       "max_batch_size": 10,
  //       "max_batch_timeout": 5
  //     }
  //   ]
  // },
  // DurableObject migrations — uncomment together with durable_objects above.
  // "migrations": [
  //   {
  //     "tag": "v1",
  //     "new_sqlite_classes": ["RateLimiter"]
  //   }
  // ],
  "vars": {
    "CORS_ORIGIN": "http://localhost:5173",
    "COOKIE_SAME_SITE": "Lax",
    "COOKIE_SECURE": "true",
    // Template default: replace with the deployed HTTPS origin in the generated app.
    "APP_BASE_URL": "http://localhost:5173",
    "EMAIL_PROVIDER": "log",
    "EMAIL_FROM": "cf-starter <noreply@example.com>",
    // Auth mode: "none" (public, no auth), "simple-admin" (ADMIN_PASSWORD only),
    // "better-auth" (full user management). Defaults to "better-auth".
    // Backward compat: AUTH_ENABLED=false is equivalent to AUTH_MODE=none.
    // "AUTH_MODE": "none",
    // ADMIN_PASSWORD: required when AUTH_MODE=simple-admin.
    //   Set via: npx wrangler secret put ADMIN_PASSWORD
    //   For local dev, add to .dev.vars: ADMIN_PASSWORD=your-password-here
    // BETTER_AUTH_SECRET: required for better-auth mode (random 32+ chars).
    //   Set via: npx wrangler secret put BETTER_AUTH_SECRET
    //   For local dev, add to .dev.vars: BETTER_AUTH_SECRET=your-secret-here
    // Set to "false" to disable authentication for local development.
    // "AUTH_ENABLED": "false"
  },
  // Cron triggers — uncomment if needed.
  // "triggers": {
  //   "crons": ["*/15 * * * *"]
  // },
  // Static assets (React SPA)
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
