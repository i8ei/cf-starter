{
  "name": "cf-starter",
  "version": "2.1.0",
  "description": "Cloudflare Workers fullstack starter template.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "cf-starter": "./bin/cf-starter"
  },
  "homepage": "https://github.com/i8ei/cf-starter#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/i8ei/cf-starter.git"
  },
  "bugs": {
    "url": "https://github.com/i8ei/cf-starter/issues"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "cli": "node scripts/cf-starter.mjs",
    "dev": "vite dev",
    "dev:split": "wrangler dev src/index.ts --port 8787 --local & vite dev --config vite.config.split.ts && kill %1",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "security-check": "node scripts/security-check.mjs",
    "deploy": "node scripts/security-check.mjs && node scripts/cf-starter.mjs deploy",
    "doctor": "node scripts/cf-starter.mjs doctor",
    "env:plan": "node scripts/cf-starter.mjs env plan",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/cf-starter.mjs db migrate",
    "db:migrate:remote": "node scripts/cf-starter.mjs db migrate --remote",
    "seed:demo": "node scripts/cf-starter.mjs db seed-demo",
    "record:generate": "node scripts/cf-starter.mjs record generate",
    "setup:remote": "node scripts/cf-starter.mjs setup remote",
    "init": "node scripts/init-copy.mjs",
    "lint": "oxlint -c oxlintrc.json app/ src/ shared/ test/ e2e/",
    "unused": "knip",
    "docs:check": "node scripts/docs-check.mjs",
    "test:e2e": "playwright test",
    "ci:local": "npm run lint && npm run typecheck && npm test && npm run unused && npm run build"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.5",
    "@tanstack/react-query": "^5",
    "better-auth": "^1.5.5",
    "drizzle-orm": "^0.43",
    "hono": "^4",
    "react": "^19",
    "react-dom": "^19",
    "react-is": "^19.2.4",
    "recharts": "^3.8.0",
    "wouter": "^3.9.0",
    "zod": "^3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1",
    "@cloudflare/workers-types": "^4",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "drizzle-kit": "^0.31",
    "esbuild": "^0.25",
    "knip": "^5.88.1",
    "oxlint": "^1.56.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^6",
    "vitest": "^3",
    "wrangler": "^4"
  }
}
