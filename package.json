{
  "name": "create-cf-starter",
  "version": "0.1.0",
  "description": "AI-friendly CLI to scaffold new apps from cf-starter.",
  "license": "UNLICENSED",
  "type": "module",
  "homepage": "https://github.com/i8ei/cf-starter#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/i8ei/cf-starter.git"
  },
  "bugs": {
    "url": "https://github.com/i8ei/cf-starter/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "cloudflare",
    "starter",
    "scaffold",
    "cli",
    "hono",
    "react"
  ],
  "files": [
    ".gitignore",
    ".github/workflows/ci.yml",
    "README.md",
    "app",
    "bin",
    "examples",
    "drizzle.config.ts",
    "index.html",
    "migrations",
    "scripts/create-cf-starter.mjs",
    "scripts/d1-migrate.mjs",
    "scripts/doctor.mjs",
    "scripts/generate-record.mjs",
    "scripts/internal/scaffold-app.mjs",
    "scripts/lib/cli-args.mjs",
    "scripts/lib/doctor.mjs",
    "scripts/lib/example-migrations.mjs",
    "scripts/lib/record-engine.mjs",
    "scripts/lib/scaffold.mjs",
    "scripts/lib/scaffold/orchestrator.mjs",
    "scripts/lib/scaffold/planner.mjs",
    "scripts/lib/scaffold/renderers/app-template.mjs",
    "scripts/lib/scaffold/renderers/readme.mjs",
    "scripts/lib/scaffold/renderers/workflow.mjs",
    "scripts/lib/scaffold/transforms/cleanup.mjs",
    "scripts/lib/scaffold/transforms/app-metadata.mjs",
    "scripts/lib/scaffold/transforms/file-ops.mjs",
    "scripts/lib/scaffold/transforms/feature-selection.mjs",
    "scripts/lib/scaffold/transforms/helpers.mjs",
    "scripts/lib/scaffold/transforms/index-selection.mjs",
    "scripts/lib/scaffold/transforms/items-selection.mjs",
    "scripts/lib/scaffold/transforms/jsonc.mjs",
    "scripts/lib/scaffold/transforms/metadata.mjs",
    "scripts/lib/scaffold/transforms/package-metadata.mjs",
    "scripts/lib/scaffold/transforms/readme-metadata.mjs",
    "scripts/lib/scaffold/transforms/scaffold-markers.mjs",
    "scripts/lib/scaffold/transforms/wrangler.mjs",
    "scripts/lib/scaffold/transforms/wrangler-metadata.mjs",
    "scripts/lib/starter-catalog.mjs",
    "scripts/lib/starter-manifest.mjs",
    "scripts/lib/template-source.mjs",
    "scripts/lib/wrangler-config.mjs",
    "scripts/seed-demo.mjs",
    "shared",
    "src",
    "test/app-security.test.ts",
    "test/audit.test.ts",
    "test/config.test.ts",
    "test/email-verification.test.ts",
    "test/email.test.ts",
    "test/example-organization-scope.test.ts",
    "test/helpers.ts",
    "test/jobs.test.ts",
    "test/logging.test.ts",
    "test/org-role.test.ts",
    "test/organizations.test.ts",
    "test/password-reset.test.ts",
    "test/password.test.ts",
    "test/rbac.test.ts",
    "test/record-engine.test.ts",
    "test/session-maintenance.test.ts",
    "test/session.test.ts",
    "tsconfig.json",
    "vite.config.split.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "wrangler.jsonc"
  ],
  "bin": {
    "create-cf-starter": "bin/create-cf-starter"
  },
  "scripts": {
    "dev": "vite dev",
    "dev:split": "wrangler dev src/index.ts --port 8787 --local & vite dev --config vite.config.split.ts && kill %1",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run",
    "test:create": "node scripts/test-create.mjs",
    "test:watch": "vitest",
    "check:publish": "node scripts/check-publish-ready.mjs",
    "template:sync": "node scripts/internal/sync-template-directory.mjs --source-dir . --target-dir template --force",
    "template:check": "node scripts/internal/check-template-directory.mjs --source-dir . --template-dir template",
    "doctor": "node scripts/doctor.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/d1-migrate.mjs",
    "db:migrate:remote": "node scripts/d1-migrate.mjs remote",
    "seed:demo": "node scripts/seed-demo.mjs",
    "record:generate": "node scripts/generate-record.mjs"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.5",
    "@tanstack/react-query": "^5",
    "drizzle-orm": "^0.43",
    "hono": "^4",
    "react": "^19",
    "react-dom": "^19",
    "wouter": "^3.9.0",
    "zod": "^3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1",
    "@cloudflare/workers-types": "^4",
    "@tailwindcss/vite": "^4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4",
    "drizzle-kit": "^0.31",
    "esbuild": "^0.25",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^6",
    "vitest": "^3",
    "wrangler": "^4"
  }
}
