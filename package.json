{
  "name": "create-cf-starter",
  "version": "0.1.0",
  "description": "AI-friendly CLI to scaffold new apps from cf-starter.",
  "license": "UNLICENSED",
  "type": "module",
  "homepage": "https://github.com/i8ei/cf-starter#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/i8ei/cf-starter.git"
  },
  "bugs": {
    "url": "https://github.com/i8ei/cf-starter/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "cloudflare",
    "starter",
    "scaffold",
    "cli",
    "hono",
    "react"
  ],
  "files": [
    ".gitignore",
    "ARCHITECTURE.md",
    "README.md",
    "ROADMAP.md",
    "app",
    "bin",
    "examples",
    "drizzle.config.ts",
    "index.html",
    "migrations",
    "scripts",
    "shared",
    "src",
    "test",
    "tsconfig.json",
    "vite.config.split.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "wrangler.jsonc"
  ],
  "bin": {
    "create-cf-starter": "bin/create-cf-starter"
  },
  "scripts": {
    "dev": "vite dev",
    "dev:split": "wrangler dev src/index.ts --port 8787 --local & vite dev --config vite.config.split.ts && kill %1",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run",
    "test:create": "node scripts/test-create.mjs",
    "test:watch": "vitest",
    "check:publish": "node scripts/check-publish-ready.mjs",
    "doctor": "node scripts/doctor.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/d1-migrate.mjs",
    "db:migrate:remote": "node scripts/d1-migrate.mjs remote",
    "seed:demo": "node scripts/seed-demo.mjs",
    "record:generate": "node scripts/generate-record.mjs"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.5",
    "@tanstack/react-query": "^5",
    "drizzle-orm": "^0.43",
    "hono": "^4",
    "react": "^19",
    "react-dom": "^19",
    "wouter": "^3.9.0",
    "zod": "^3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1",
    "@cloudflare/workers-types": "^4",
    "@tailwindcss/vite": "^4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4",
    "drizzle-kit": "^0.31",
    "esbuild": "^0.25",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^6",
    "vitest": "^3",
    "wrangler": "^4"
  }
}
